---
import BaseLayout from '../layouts/BaseLayout.astro';
import career from '../data/career.json';
const salesforce = career.experience.filter(role => role.id.startsWith('salesforce-'));
const conway = career.experience.filter(role => role.id.startsWith('conway-'));
const earlier = career.experience.filter(role => !role.id.startsWith('salesforce-') && !role.id.startsWith('conway-'));
---
<BaseLayout title="Experience — Andrew Pella" description="Engineering depth and technical project, product, and program ownership across Salesforce, Con-way, and enterprise technology operations.">
  <section class="page-intro"><p class="eyebrow">Career experience</p><h1>Engineering depth.<br />Product and program ownership.</h1><p class="hero-positioning">A career spanning hands-on technical delivery, enterprise platform ownership, and cross-team leadership.</p></section>
  <section class="section" aria-labelledby="salesforce-heading"><h2 id="salesforce-heading">Salesforce</h2><div class="stack-list">
    {salesforce.map(role => <article class="experience-entry" id={role.id}><h3>{role.title}</h3>{'functionalAssignment' in role && <p class="card-role">{role.functionalAssignment}</p>}<p>{role.employer} · {role.dateDisplay}</p><p>{role.summary}</p><ul>{role.highlights.filter(item => !item.includes('OpenTelemetry')).map(item => <li>{item}</li>)}</ul>{role.id === 'salesforce-sre-product' && <details><summary>Supporting delivery example: OpenTelemetry</summary><p>{role.highlights.find(item => item.startsWith('Led an OpenTelemetry'))}</p><a href="/projects/otel-evaluation">Read the supporting case study →</a></details>}{role.id === 'salesforce-client-engineering' && <a href="/projects/enterprise-mobility">Read the mobility program case study →</a>}</article>)}
  </div></section>
  <section class="section" aria-labelledby="conway-heading"><p class="section-kicker">Nationwide enterprise projects</p><h2 id="conway-heading">Con-way (XPO)</h2><p>Technical architecture, project leadership, and deployment coordination across a nationwide freight network.</p><div class="stack-list">{conway.map(role => <article class="experience-entry" id={role.id}><h3>{role.title}</h3><p>{role.employer} · {role.dateDisplay}</p><p>{role.summary}</p><ul>{role.highlights.map(item => <li>{item}</li>)}</ul></article>)}</div><p><a class="button" href="/projects/conway-enterprise-programs">Explore Con-way enterprise programs →</a></p></section>
  <section class="section" aria-labelledby="earlier-heading"><p class="section-kicker">Earlier career & additional experience</p><h2 id="earlier-heading">Infrastructure, architecture & technical operations</h2><div class="stack-list">{earlier.map(role => <article class="experience-entry" id={role.id}><h3>{role.title}</h3><p>{role.employer} · {role.dateDisplay}</p><p>{role.summary}</p></article>)}</div></section>
  <section class="section"><h2>Explore more</h2><p>Review <a href="/projects">selected programs</a>, the <a href="/resume">public resume</a>, or <a href="/contact">contact Andrew</a>.</p></section>
</BaseLayout>
