---
import BaseLayout from '../layouts/BaseLayout.astro';
import career from '../data/career.json';

const skillMap = new Map(career.skills.map((skill) => [skill.id, skill.label]));
const recentExperienceIds = new Set([
  'salesforce-sre-product',
  'salesforce-mobile-windows-product',
  'salesforce-client-engineering',
]);
const recentExperience = career.experience.filter((role) => recentExperienceIds.has(role.id));
const earlierExperience = career.experience.filter((role) => !recentExperienceIds.has(role.id));
const evidenceGroups = [
  {
    title: 'Technical product and program leadership',
    ids: ['salesforce-sre-product', 'salesforce-mobile-windows-product'],
    summary: 'Senior Product Owner and Product Manager leadership across enterprise platforms, operational services, roadmaps, prioritization, delivery coordination, and executive review.'
  },
  {
    title: 'Enterprise infrastructure and IT operations',
    ids: ['salesforce-client-engineering', 'conway-senior-systems-analyst', 'hp-technical-consultant'],
    summary: 'Hands-on architecture and engineering experience spanning infrastructure, networking, client computing, vendor coordination, deployment readiness, lifecycle support, and production operations.'
  },
  {
    title: 'Endpoint, mobility, and digital workplace',
    ids: ['salesforce-mobile-windows-product', 'salesforce-client-engineering'],
    summary: 'Product leadership and hands-on engineering across Windows, enterprise mobility, endpoint lifecycle, access, service delivery, and digital-workplace services.'
  },
  {
    title: 'SRE, observability, and reliability platforms',
    ids: ['salesforce-sre-product'],
    summary: 'Product and portfolio leadership across Logging, Monitoring, Tools Development, and Incident Management, including Splunk, Logstash, New Relic, Grafana, PagerDuty, and OpenTelemetry.',
    href: '/projects/otel-evaluation'
  },
  {
    title: 'AI-assisted operations',
    ids: ['salesforce-sre-product'],
    summary: 'Governed AI-assisted workflow design with human approval, validation, traceability, access controls, exception handling, failure routing, and auditability.',
    href: '/projects/agentic-job-search'
  },
  {
    title: 'Large-scale implementation and deployment',
    ids: ['salesforce-client-engineering', 'conway-senior-systems-analyst'],
    summary: 'Technology transformation from requirements and proof of concept through pilot, phased rollout, production deployment, modernization, and lifecycle management across enterprise-scale environments.'
  },
];
---

<BaseLayout title="Experience — Andrew Pella" description="Technical product and program leadership grounded in enterprise infrastructure, IT operations, platforms, reliability, endpoint services, automation, and AI-assisted operations.">
  <section class="page-intro">
    <p class="eyebrow">Experience</p>
    <h1>Technical leadership across product, program, infrastructure, and operations</h1>
    <p class="hero-positioning">Andrew's career combines senior technical product and program leadership with hands-on experience in enterprise infrastructure, IT operations, endpoint services, mobility, digital workplace technology, SRE platforms, automation, and large-scale technology transformation.</p>
  </section>

  <section class="section" aria-labelledby="evidence-heading">
    <p class="section-kicker">Search and recruiter context</p>
    <h2 id="evidence-heading">Evidence by domain</h2>
    <div class="card-grid">
      {evidenceGroups.map((group) => (
        <article class="card">
          <h3>{group.title}</h3>
          <p>{group.summary}</p>
          {group.href && <p><a href={group.href}>View related case study</a></p>}
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="recent-heading">
    <p class="section-kicker">Recent experience</p>
    <h2 id="recent-heading">Salesforce</h2>
    <div class="stack-list">
      {recentExperience.map((role) => (
        <article class="experience-entry" id={role.id}>
          <h3>{role.title}</h3>
          {'functionalAssignment' in role && role.functionalAssignment && <p class="card-role">{role.functionalAssignment}</p>}
          <p>{role.employer} · {role.dateDisplay}</p>
          <p>{role.summary}</p>
          <ul>
            {role.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <ul class="tag-list" aria-label={`Skills for ${role.title}`}>
            {role.skillIds.map((id) => <li>{skillMap.get(id)}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="earlier-heading">
    <p class="section-kicker">Earlier career</p>
    <h2 id="earlier-heading">Infrastructure, architecture, technical operations, and deployment leadership</h2>
    <div class="stack-list compact-list">
      {earlierExperience.map((role) => (
        <article class="experience-entry" id={role.id}>
          <h3>{role.title}</h3>
          <p>{role.employer} · {role.dateDisplay}</p>
          <p>{role.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Explore More</h2>
    <p>Review <a href="/projects">project evidence</a>, the <a href="/resume">public resume</a>, or <a href="/contact">contact Andrew</a>.</p>
  </section>
</BaseLayout>
