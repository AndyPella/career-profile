---
import BaseLayout from '../../layouts/BaseLayout.astro';
import career from '../../data/career.json';

const project = career.projects.find((item) => item.id === 'northstar-ridge');
if (!project) throw new Error('Approved Northstar Ridge project data is missing.');
const skills = career.skills.filter((skill) => project.skillIds.includes(skill.id));
const portfolio = career.links.find((link) => link.id === 'github-public-portfolio');
---

<BaseLayout title="Northstar Ridge — Andrew Pella" description={project.summary}>
  <section class="page-intro">
    <p class="eyebrow">Portfolio case study</p>
    <h1>{project.title}</h1>
    <p class="hero-positioning">{project.summary}</p>
    <p class="card-role">Role: {project.role}</p>
  </section>

  <section class="section">
    <p class="section-kicker">Product challenge</p>
    <h2>Structure an AI-assisted operational readiness problem</h2>
    <p>Northstar Ridge uses a fictional equipment-rental scenario to demonstrate how an operational problem can be framed as a product, decomposed into workflows and requirements, and designed with explicit boundaries between human judgment, deterministic controls, automation, and AI assistance.</p>
  </section>

  <section class="section">
    <p class="section-kicker">Approach</p>
    <h2>From product framing to implementation-ready evidence</h2>
    <ol class="step-list">
      {project.approach.map((item) => <li>{item}</li>)}
      <li>Documented assumptions, requirements, architecture, decision records, synthetic operational data, and validation evidence.</li>
      <li>Built a TypeScript / Next.js prototype foundation to demonstrate implementation fluency alongside product leadership.</li>
    </ol>
  </section>

  <section class="section">
    <p class="section-kicker">Evidence</p>
    <h2>Public portfolio implementation</h2>
    <ul>
      {project.outcomes.map((item) => <li>{item}</li>)}
      <li>The project uses fictional company data and synthetic operational scenarios rather than employer-confidential or customer information.</li>
    </ul>
    {portfolio && <p><a href={portfolio.url}>Explore the Northstar Ridge source, documentation, and prototype on GitHub</a>.</p>}
  </section>

  <section class="section">
    <h2>Related expertise</h2>
    <ul class="tag-list">
      {skills.map((skill) => <li>{skill.label}</li>)}
    </ul>
  </section>

  <section class="section">
    <h2>Continue</h2>
    <p>Return to the <a href="/">profile</a>, browse <a href="/projects">all project evidence</a>, review the <a href="/resume">public resume</a>, or <a href="/contact">contact Andrew</a>.</p>
  </section>
</BaseLayout>
