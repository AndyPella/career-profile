---
import BaseLayout from '../../layouts/BaseLayout.astro';
import career from '../../data/career.json';

const project = career.projects.find((item) => item.id === 'agentic-career-workflow');
if (!project) throw new Error('Approved agentic workflow project data is missing.');
const skills = career.skills.filter((skill) => project.skillIds.includes(skill.id));
const portfolio = career.links.find((link) => link.id === 'github-public-portfolio');
---

<BaseLayout title="Agentic Career Workflow — Andrew Pella" description={project.summary}>
  <section class="page-intro">
    <p class="eyebrow">Case study</p>
    <h1>{project.title}</h1>
    <p class="hero-positioning">{project.summary}</p>
    <p class="card-role">Role: {project.role}</p>
  </section>

  <section class="section">
    <p class="section-kicker">Problem and context</p>
    <h2>Turn a multi-stage career workflow into a governed operating model</h2>
    <p>The project explores progression from GenAI assistance toward a structured workflow in which specialized stages coordinate discovery, evaluation, generation, validation, approval, tracking, and iterative improvement while preserving explicit human decision gates.</p>
  </section>

  <section class="section">
    <p class="section-kicker">Workflow</p>
    <h2>Workflow and approval points</h2>
    <figure class="workflow-figure">
      <a href="/images/agentic-career-workflow.svg" aria-label="Open the career workflow diagram at full size">
        <img src="/images/agentic-career-workflow.svg" width="1200" height="700" loading="lazy"
          alt="Eight workflow stages: Discover, Qualify and Evaluate, Human Decision, Generate, Validate, Approve, Track, and Learn and Improve. Human Decision and Approve are human-controlled gates." />
      </a>
      <figcaption>Human decisions and approval gates control progression. The person chooses work, authorizes materials, submits applications and confirms what actually happened.</figcaption>
    </figure>
    <details class="workflow-transcript">
      <summary>Read the workflow stages</summary>
      <ol class="step-list">
        {project.workflow.map((step) => <li>{step}</li>)}
      </ol>
    </details>
  </section>

  <section class="section">
    <p class="section-kicker">Design decisions</p>
    <h2>How I structured the work</h2>
    <p>My role combines product ownership, workflow design and testing. I use explicit states and decision points to make the next action clear and keep consequential choices with the person using the workflow.</p>
    <ol class="step-list">
      {project.approach?.map((decision) => <li>{decision}</li>)}
    </ol>
  </section>

  <section class="section">
    <p class="section-kicker">Lessons from testing</p>
    <h2>An output needs evidence of completion</h2>
    <p>Testing reinforced a practical distinction: creating a document does not establish that an application was submitted, and a current status does not describe the whole history. I keep those events separate, check the supporting evidence and use discrepancies to improve the process.</p>
    <p>This case study demonstrates workflow design and governance. It does not claim a measured improvement in hiring outcomes.</p>
  </section>

  <section class="section">
    <p class="section-kicker">Agentic properties</p>
    <h2>Governed orchestration rather than simple prompting</h2>
    <ul>
      {project.agenticProperties.map((property) => <li>{property}</li>)}
    </ul>
  </section>

  <section class="section">
    <p class="section-kicker">Governance</p>
    <h2>Human approval remains explicit</h2>
    <p>The public case study intentionally excludes private application records, recruiter communications, private prompts and source files, credentials, tokens, and sensitive implementation details. It also does not claim that Andrew personally coded every agent or automation capability.</p>
  </section>

  <section class="section">
    <h2>Related expertise</h2>
    <ul class="tag-list">
      {skills.map((skill) => <li>{skill.label}</li>)}
    </ul>
    {portfolio && <p><a href={portfolio.url}>View Andrew's public AI portfolio project</a></p>}
  </section>

  <section class="section">
    <h2>Continue</h2>
    <p>Return to the <a href="/">profile</a>, browse <a href="/projects">all project evidence</a>, review the <a href="/resume">public resume</a>, or <a href="/contact">contact Andrew</a>.</p>
  </section>
</BaseLayout>

<style>
  .workflow-figure { margin: 1.75rem 0 1rem; }
  .workflow-figure a { display: block; }
  .workflow-figure img { display: block; width: 100%; height: auto; border: 1px solid var(--brand-border); }
  .workflow-figure figcaption { max-width: 56rem; margin-top: 0.85rem; color: var(--brand-text); font-size: 0.95rem; }
  .workflow-transcript { margin-top: 1.25rem; }
  .workflow-transcript summary { cursor: pointer; font-weight: 700; color: var(--brand-navy); }
</style>
