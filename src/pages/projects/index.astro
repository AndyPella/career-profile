---
import BaseLayout from '../../layouts/BaseLayout.astro';
import career from '../../data/career.json';

const portfolio = career.links.find((link) => link.id === 'github-public-portfolio');
const routes: Record<string, string | undefined> = {
  'otel-evaluation': '/projects/otel-evaluation',
  'agentic-career-workflow': '/projects/agentic-job-search',
  'northstar-ridge': portfolio?.url,
};
---

<BaseLayout title="Projects — Andrew Pella" description="Project evidence across OpenTelemetry, AI-assisted operations, automation, and governed agentic workflows.">
  <section class="page-intro">
    <p class="eyebrow">Projects</p>
    <h1>Evidence through applied work</h1>
    <p class="hero-positioning">Selected projects connect product leadership claims to concrete evaluation, workflow, governance, and portfolio evidence.</p>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Project and case-study index</h2>
    <div class="card-grid">
      {career.projects.map((project) => {
        const route = routes[project.id];
        return (
          <article class="card">
            <h3>{route ? <a href={route}>{project.title}</a> : project.title}</h3>
            <p class="card-role">{project.role}</p>
            <p>{project.summary}</p>
            {route && <p><a href={route}>View project evidence</a></p>}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section">
    <h2>Continue</h2>
    <p>Connect this evidence to <a href="/experience">career experience</a>, review the <a href="/resume">public resume</a>, or <a href="/contact">contact Andrew</a>.</p>
  </section>
</BaseLayout>
