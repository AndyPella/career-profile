---
import BaseLayout from '../layouts/BaseLayout.astro';
import career from '../data/career.json';
import ProgramCards from '../components/ProgramCards.astro';
import ScopeStats from '../components/ScopeStats.astro';
const linkedin = career.links.find(link => link.id === 'linkedin');
const github = career.links.find(link => link.id === 'github-profile');
---
<BaseLayout title="Andrew Pella — Technical Project & Program Leader" description={career.profile.summaryDetail}>
  <section class="hero" aria-labelledby="profile-heading">
    <p class="eyebrow">Technical project & program leadership</p>
    <h1 id="profile-heading">Technical ownership.<br />From first requirements<br />to production operations.</h1>
    <p class="hero-positioning">{career.profile.summary}</p>
    <p class="hero-summary">{career.profile.summaryDetail}</p>
    <div class="hero-actions"><a class="button" href="/projects">Explore selected programs →</a><a class="button button-secondary" href="/experience">View career experience</a></div>
  </section>
  <ScopeStats />
  <section class="section" id="evidence" aria-labelledby="evidence-heading">
    <p class="section-kicker">Selected programs & transformations</p>
    <h2 id="evidence-heading">Enterprise scale. Clear ownership.</h2>
    <ProgramCards />
  </section>
  <section class="section" aria-labelledby="independent-heading">
    <p class="section-kicker">Independent projects & applied AI</p>
    <h2 id="independent-heading">New tools. The same ownership mindset.</h2>
    <p>Recent independent work exploring product design, AI-assisted operations, and governed workflows.</p>
    <a href="/independent-work">Explore independent work →</a>
  </section>
  <section class="section contact-panel" id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Connect with Andrew Pella</h2>
    <div class="hero-actions"><a class="button" href={`mailto:${career.contact.email}`}>Email Andrew</a>{linkedin && <a class="button button-secondary" href={linkedin.url} rel="me">LinkedIn</a>}{github && <a class="button button-secondary" href={github.url} rel="me">GitHub</a>}</div>
  </section>
</BaseLayout>
