---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <h1>Andrew Pella</h1>
    <p>Career profile foundation is under active development.</p>
    <p>
      Release 1 will provide a concise human-readable profile alongside structured,
      machine-readable career information from the same approved public content model.
    </p>
  </section>

  <section class="machine-note" aria-labelledby="machine-access-heading">
    <h2 id="machine-access-heading">Human and machine access</h2>
    <p>
      Planned Release 1 outputs include experience, projects, resume, structured data,
      Markdown, JSON, and AI-readable discovery resources.
    </p>
  </section>
</BaseLayout>
