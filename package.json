{
  "name": "career-profile",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "validate:source": "node scripts/validate-public-source.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "check:release": "npm run validate:source && npm run validate:download && npm run test:download && npm run build && npm run validate:release",
    "preview": "astro preview",
    "validate:download": "node scripts/check-resume-download.mjs",
    "test:download": "node --test scripts/check-resume-download.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.7"
  }
}
